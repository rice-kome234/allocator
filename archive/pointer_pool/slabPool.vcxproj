    <None Include="docs\benchmark-pointer-growth-quick.txt" />
    <None Include="docs\benchmark-pointer-parallel-quick.txt" />
    <None Include="docs\benchmark-pointer-churn-quick.txt" />
    <None Include="docs\benchmark-pointer-bulk-quick.txt" />
    <None Include="scripts\build.ps1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <Target Name="CopyAddressSanitizerRuntime" AfterTargets="Build" Condition="'$(Sanitize)'=='true'">
    <Copy SourceFiles="$(VCToolsInstallDir)bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
